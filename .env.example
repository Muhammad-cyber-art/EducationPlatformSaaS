# --- Django Settings ---
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost,.crm.uz,admin.crm.uz,app.crm.uz

# --- Database Configuration ---
DB_ENGINE=postgresql
DB_NAME=education_db
DB_USER=education_user
DB_PASSWORD=secure-db-password
DB_HOST=db
DB_PORT=5432

# PostgreSQL Internal (for docker image)
POSTGRES_DB=education_db
POSTGRES_USER=education_user
POSTGRES_PASSWORD=secure-db-password

# --- External APIs ---
TELEGRAM_BOT_TOKEN=your-bot-token

# --- Celery & Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Security ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- Frontend ---
VITE_API_URL=/

# ─── Multi-Tenant SaaS Konfiguratsiyasi ───────────────────────────────────────
# Asosiy platforma domeni (subdomenlari tenant sifatida taniladi)
TENANT_BASE_DOMAIN=crm.uz

# CEO / Platform Super Admin panel domenlari (vergul bilan ajratiladi)
TENANT_CEO_DOMAINS=admin.crm.uz,app.crm.uz

# Development: True bo'lsa X-Tenant-Schema header orqali tenant tanlash mumkin
# PRODUCTION'DA ALBATTA False QILING!
TENANT_DEV_SCHEMA_HEADER=False

# CORS: CEO panel frontendan so'rov qabul qilish uchun
CORS_ALLOWED_ORIGINS=https://admin.crm.uz,https://app.crm.uz
